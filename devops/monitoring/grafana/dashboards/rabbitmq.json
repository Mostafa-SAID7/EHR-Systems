{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "RabbitMQ metrics — Queues, Consumers, DLQ, Retries",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "expr": "sum(rabbitmq_queue_messages)",
          "legendFormat": "Total Queue Depth",
          "refId": "A"
        }
      ],
      "title": "Total Queue Depth",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "green", "value": 1 },
              { "color": "red", "value": 0 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": {
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "sum(rabbitmq_consumers)",
          "legendFormat": "Active Consumers",
          "refId": "A"
        }
      ],
      "title": "Active Consumers",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": {
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "sum(rabbitmq_queue_messages{queue=~\".*\\\\.dlq\"})",
          "legendFormat": "DLQ Messages",
          "refId": "A"
        }
      ],
      "title": "Dead-Letter Queue",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": {
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "sum(increase(rabbitmq_messages_redelivered_total[5m]))",
          "legendFormat": "Redelivered (5m)",
          "refId": "A"
        }
      ],
      "title": "Redelivered Messages",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "targets": [
        {
          "expr": "rabbitmq_queue_messages by (queue)",
          "legendFormat": "{{ queue }}",
          "refId": "A"
        }
      ],
      "title": "Queue Depth by Queue",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "targets": [
        {
          "expr": "rabbitmq_consumers by (queue)",
          "legendFormat": "{{ queue }}",
          "refId": "A"
        }
      ],
      "title": "Active Consumers by Queue",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "ops" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 7,
      "targets": [
        {
          "expr": "sum by (queue) (rate(rabbitmq_messages_published_total[5m]))",
          "legendFormat": "Publish Rate {{ queue }}",
          "refId": "A"
        },
        {
          "expr": "sum by (queue) (rate(rabbitmq_messages_confirmed_total[5m]))",
          "legendFormat": "Ack Rate {{ queue }}",
          "refId": "B"
        }
      ],
      "title": "Publish & Ack Rate by Queue",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 8,
      "targets": [
        {
          "expr": "sum by (queue) (increase(rabbitmq_messages_redelivered_total[5m]))",
          "legendFormat": "Redelivered {{ queue }}",
          "refId": "A"
        },
        {
          "expr": "sum by (queue) (increase(rabbitmq_messages_unacked[5m]))",
          "legendFormat": "Unacked {{ queue }}",
          "refId": "B"
        }
      ],
      "title": "Redelivered & Unacked by Queue",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 38,
  "tags": ["ehr", "rabbitmq", "messaging"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "RabbitMQ — Queues, Consumers, DLQ, Retries",
  "uid": "ehr-rabbitmq",
  "version": 1
}
