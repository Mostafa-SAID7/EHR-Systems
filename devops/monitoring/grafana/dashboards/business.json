      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }
      },
      "pluginVersion": "10.0.0",
      "targets": [
