{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Database metrics — Connections, Slow Queries, Deadlocks, Timeouts",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 80 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "expr": "sum(pg_stat_activity_count{state=\"active\"})",
          "legendFormat": "Active Connections",
          "refId": "A"
        }
      ],
      "title": "Active DB Connections",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": {
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "sum(pg_slow_queries_total)",
          "legendFormat": "Slow Queries",
          "refId": "A"
        }
      ],
      "title": "Slow Queries (>100ms)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": {
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "sum(increase(pg_deadlocks_total[5m]))",
          "legendFormat": "Deadlocks",
          "refId": "A"
        }
      ],
      "title": "Deadlocks (5m)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": {
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "expr": "sum(increase(db_query_timeouts_total[5m]))",
          "legendFormat": "Query Timeouts",
          "refId": "A"
        }
      ],
      "title": "Query Timeouts (5m)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "targets": [
        {
          "expr": "pg_stat_activity_count by (datname, state)",
          "legendFormat": "{{ datname }} - {{ state }}",
          "refId": "A"
        }
      ],
      "title": "Connections by Database & State",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "ms" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, datname) (rate(pg_query_duration_seconds_bucket[5m]))) * 1000",
          "legendFormat": "p95 {{ datname }}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, datname) (rate(pg_query_duration_seconds_bucket[5m]))) * 1000",
          "legendFormat": "p99 {{ datname }}",
          "refId": "B"
        }
      ],
      "title": "Query Duration p95/p99",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "bytes" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 7,
      "targets": [
        {
          "expr": "pg_database_size_bytes by (datname)",
          "legendFormat": "{{ datname }}",
          "refId": "A"
        }
      ],
      "title": "Database Size",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 8,
      "targets": [
        {
          "expr": "sum by (datname) (increase(pg_transactions_committed_total[5m]))",
          "legendFormat": "Committed {{ datname }}",
          "refId": "A"
        },
        {
          "expr": "sum by (datname) (increase(pg_transactions_rolled_back_total[5m]))",
          "legendFormat": "Rolled back {{ datname }}",
          "refId": "B"
        }
      ],
      "title": "Transactions (5m)",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 38,
  "tags": ["ehr", "database", "postgres"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Database — Connections, Slow Queries, Deadlocks, Timeouts",
  "uid": "ehr-database",
  "version": 1
}
