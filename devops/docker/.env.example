# =============================================================================
# EHR Platform — Environment Variables
# =============================================================================
# Copy this file to devops/docker/.env and fill in real values.
# NEVER commit .env to source control.
# =============================================================================

# ── Image versioning ──────────────────────────────────────────────────────────
IMAGE_TAG=latest

# ── JWT & Encryption ─────────────────────────────────────────────────────────
# JWT_SECRET must be at least 32 characters
JWT_SECRET=change-me-at-least-32-characters-long!
# ENCRYPTION_KEY must be exactly 32 characters (AES-256)
ENCRYPTION_KEY=change-me-32-chars-aes-256-keyxx

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_USER=ehr_admin
MONGO_PASSWORD=ehr_mongo_password

# ── MySQL (billing) ──────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root_password
MYSQL_USER=ehr_billing_user
MYSQL_PASSWORD=billing_password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_password

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_USER=ehr_user
RABBITMQ_PASSWORD=ehr_password

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ── External integrations (production / staging only) ────────────────────────
# SENDGRID_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
