# =============================================================================
# Multi-stage Dockerfile — ASP.NET Core 8 Microservice
# =============================================================================
# Build:
#   docker build -t ehr/identity-service:latest \
#     --build-arg SERVICE=EHRPlatform.Services.Identity \
#     -f devops/docker/services/Dockerfile.backend .
# (run from the repo root)
# =============================================================================

ARG DOTNET_VERSION=8.0

# ── Stage 1: restore ─────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_VERSION} AS restore
ARG SERVICE=EHRPlatform.Services.Identity
WORKDIR /src

# Copy solution & project files first — maximises layer cache hits
COPY backend/EHRPlatform.sln                                    backend/
COPY backend/src/EHRPlatform.Common/EHRPlatform.Common.csproj  backend/src/EHRPlatform.Common/
COPY backend/src/${SERVICE}/${SERVICE}.csproj                   backend/src/${SERVICE}/

WORKDIR /src/backend
RUN dotnet restore "EHRPlatform.sln" --locked-mode 2>/dev/null \
 || dotnet restore "EHRPlatform.sln"

# ── Stage 2: build ────────────────────────────────────────────────────────────
FROM restore AS build
ARG SERVICE=EHRPlatform.Services.Identity

COPY backend/src/ /src/backend/src/

WORKDIR /src/backend
RUN dotnet build "EHRPlatform.sln" \
    -c Release \
    --no-restore \
    -o /app/build

# ── Stage 3: publish ─────────────────────────────────────────────────────────
FROM build AS publish
ARG SERVICE=EHRPlatform.Services.Identity

RUN dotnet publish "src/${SERVICE}/${SERVICE}.csproj" \
    -c Release \
    --no-build \
    -o /app/publish \
    /p:UseAppHost=false

# ── Stage 4: runtime ─────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/aspnet:${DOTNET_VERSION} AS runtime
ARG SERVICE=EHRPlatform.Services.Identity

WORKDIR /app

# Install curl for the HEALTHCHECK
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/*

# Non-root user (HIPAA: principle of least privilege)
RUN addgroup --system appgroup \
 && adduser  --system --ingroup appgroup --no-create-home appuser

COPY --from=publish --chown=appuser:appgroup /app/publish .

# Store the service DLL name so the entrypoint shell can resolve it
ENV SERVICE_NAME=${SERVICE}
ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD curl -sf http://localhost:8080/health || exit 1

USER appuser

# Use shell form so $SERVICE_NAME is expanded at container start
ENTRYPOINT ["sh", "-c", "exec dotnet \"${SERVICE_NAME}.dll\""]
