{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Elasticsearch" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=ehr_clinical_db;Username=ehr_user;Password=ehr_password;"
  },
  "MongoDB": {
    "ConnectionString": "mongodb://ehr_user:ehr_password@localhost:27017",
    "DatabaseName": "ehr_clinical_documents"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Elasticsearch": {
    "Uri": "http://localhost:9200"
  },
  "Jwt": {
    "Secret": "change-me-in-production-minimum-32-characters",
    "Issuer": "ehr-platform",
    "Audience": "ehr-services",
    "ExpirationMinutes": 60
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "ehr_user",
    "Password": "ehr_password",
    "ExchangeName": "ehr.events"
  },
  "AllowedHosts": "*",
  "Urls": "http://+:5003"
}
