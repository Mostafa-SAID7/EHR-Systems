{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "MassTransit": "Information",
        "EHRPlatform": "Debug"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/patient-service-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName"]
  },
  "Kafka": {
    "BootstrapServers": "",
    "ConsumerGroup": "patient-service"
  },
  "RabbitMQ": {
    "Host": "",
    "Username": "ehr_user",
    "Password": "ehr_password",
    "VirtualHost": "/ehr"
  },
  "Redis": {
    "ConnectionString": ""
  },
  "Elasticsearch": {
    "Url": ""
  },
  "MongoDB": {
    "ConnectionString": "",
    "DatabaseName": "ehr_patient"
  },
  "EHRCommon": {
    "RedisConnectionString": "",
    "EncryptionKey": "ehr-platform-dev-encrypt-key-32c",
    "EnableCaching": false,
    "EnableEncryption": true,
    "EnableLogging": false
  },
  "Jwt": {
    "Secret": "your-super-secret-key-change-in-production-at-least-32-characters-long!",
    "Issuer": "ehr-platform",
    "Audience": "ehr-api",
    "ExpirationMinutes": 60
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "AllowedHosts": "*"
}
