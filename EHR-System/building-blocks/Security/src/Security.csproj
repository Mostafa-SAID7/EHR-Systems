<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>EHRPlatform.BuildingBlocks.Security</PackageId>
    <Version>1.0.0</Version>
    <Authors>EHR Platform Team</Authors>
    <Description>Security building block including JWT authentication, RBAC/ABAC authorization, encryption utilities, and resilience policies for healthcare data protection.</Description>
    <PackageTags>healthcare;microservices;security;jwt;authentication;authorization;encryption</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.6.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="7.6.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />
    <PackageReference Include="Polly" Version="8.4.1" />
    <PackageReference Include="Polly.CircuitBreaker" Version="8.4.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SharedKernel/src/SharedKernel.csproj" />
  </ItemGroup>

</Project>
