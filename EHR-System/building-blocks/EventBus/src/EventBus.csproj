<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>EHRPlatform.BuildingBlocks.EventBus</PackageId>
    <Version>1.0.0</Version>
    <Authors>EHR Platform Team</Authors>
    <Description>Event bus and CQRS infrastructure for event-driven communication between microservices. Includes MediatR integration, behaviors, and message handling.</Description>
    <PackageTags>healthcare;microservices;eventbus;cqrs;messaging;mediatr</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="12.3.0" />
    <PackageReference Include="MassTransit" Version="8.4.3" />
    <PackageReference Include="Serilog" Version="4.1.0" />
    <PackageReference Include="FluentValidation" Version="11.9.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SharedKernel/src/SharedKernel.csproj" />
  </ItemGroup>

</Project>
