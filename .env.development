# EHR Platform Development Configuration - Polyglot Database System

# ─────────────────────────────────────────────────────────────────
# PostgreSQL (Primary Relational Database)
# ─────────────────────────────────────────────────────────────────
POSTGRES_DB=ehr_platform
POSTGRES_USER=ehr_user
POSTGRES_PASSWORD=ehr_password

# ─────────────────────────────────────────────────────────────────
# MySQL (Secondary Relational Database)
# ─────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=ehr_root_password
MYSQL_DATABASE=ehr_platform
MYSQL_USER=ehr_user
MYSQL_PASSWORD=ehr_password

# ─────────────────────────────────────────────────────────────────
# MongoDB (Document Database)
# ─────────────────────────────────────────────────────────────────
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=ehr_root_password
MONGO_DATABASE=ehr_platform

# ─────────────────────────────────────────────────────────────────
# Connection Strings (for .NET services)
# ─────────────────────────────────────────────────────────────────
ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=ehr_platform;Username=ehr_user;Password=ehr_password;Include Error Detail=true
ConnectionStrings__MySQL=Server=mysql;Port=3306;Database=ehr_platform;Uid=ehr_user;Pwd=ehr_password;
ConnectionStrings__MongoDB=mongodb://root:ehr_root_password@mongodb:27017/ehr_platform?authSource=admin

# ─────────────────────────────────────────────────────────────────
# Redis Cache
# ─────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_password
ConnectionStrings__Redis=redis:6379,password=redis_password
EHRCommon__RedisConnectionString=redis:6379,password=redis_password
EHRCommon__EnableCaching=true

# ─────────────────────────────────────────────────────────────────
# Elasticsearch Search
# ─────────────────────────────────────────────────────────────────
Elasticsearch__Urls=http://elasticsearch:9200
Elasticsearch__Username=elastic
Elasticsearch__Password=changeme

# ─────────────────────────────────────────────────────────────────
# Kafka Messaging
# ─────────────────────────────────────────────────────────────────
Kafka__BootstrapServers=kafka:9092
Kafka__Environment=development
Kafka__Topics__PatientEvents=patient-events
Kafka__Topics__AppointmentEvents=appointment-events
Kafka__Topics__BillingEvents=billing-events
Kafka__Topics__AnalyticsEvents=analytics-events
Kafka__Topics__AuditEvents=audit-events
Kafka__Topics__NotificationEvents=notification-events

# ─────────────────────────────────────────────────────────────────
# JWT Configuration
# ─────────────────────────────────────────────────────────────────
Jwt__Secret=your-super-secret-key-change-in-production-at-least-32-characters-long!
Jwt__Issuer=ehr-platform
Jwt__Audience=ehr-api
Jwt__ExpirationMinutes=60
Jwt__RefreshTokenExpirationDays=7

# ─────────────────────────────────────────────────────────────────
# API Configuration
# ─────────────────────────────────────────────────────────────────
Api__Url=http://api-gateway:5000
Api__Port=5000
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000

# ─────────────────────────────────────────────────────────────────
# Security & HIPAA
# ─────────────────────────────────────────────────────────────────
Security__EncryptionKey=your-encryption-key-32-characters-minimum!
Security__RequireHttps=false
Security__AllowLocalhost=true
EHRCommon__EnableEncryption=true

# ─────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft=Warning
Serilog__MinimumLevel=Information
Serilog__WriteTo__Console__Enabled=true
Serilog__WriteTo__File__Enabled=true
Serilog__WriteTo__File__Path=logs/ehr-.txt
EHRCommon__EnableLogging=true

# ─────────────────────────────────────────────────────────────────
# Feature Flags
# ─────────────────────────────────────────────────────────────────
Features__EnableAuditLogging=true
Features__EnableEventSourcing=true
Features__EnableCaching=true
Features__EnableSearch=true
Features__EnableMessaging=true

# ─────────────────────────────────────────────────────────────────
# Grafana & Monitoring
# ─────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ─────────────────────────────────────────────────────────────────
# Outbox Processor
# ─────────────────────────────────────────────────────────────────
OutboxProcessor__PollIntervalMs=5000
OutboxProcessor__BatchSize=100
OutboxProcessor__MaxRetries=3
OutboxProcessor__RetryDelayMs=1000
