{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=ehr_platform;Username=ehr_user;Password=ehr_password;Include Error Detail=true"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Topics": {
      "PatientEvents": "patient-events",
      "AppointmentEvents": "appointment-events",
      "BillingEvents": "billing-events",
      "AnalyticsEvents": "analytics-events",
      "AuditEvents": "audit-events",
      "NotificationEvents": "notification-events"
    }
  },
  "OutboxProcessor": {
    "PollIntervalMs": 5000,
    "BatchSize": 100,
    "MaxRetries": 3,
    "RetryDelayMs": 1000
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  }
}
